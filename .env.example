# Copy to .env for local development. Never commit the real file.
#
# Adzuna is the only source that needs credentials, and it is the one that
# carries India coverage — the three ATS sources work with no key at all.
# Register free at https://developer.adzuna.com (about two minutes).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Sent in the User-Agent so API operators can identify and contact us.
QUANTYX_CONTACT_URL=https://github.com/<your-username>/quantyx
